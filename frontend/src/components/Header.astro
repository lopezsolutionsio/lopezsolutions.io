---
const links = [
  { href: "/", label: "Inicio" },
  { href: "/posts", label: "Vlog" },
  { href: "/projects", label: "Portafolio" },
  { href: "/about", label: "Sobre mí" },
];
---

<header class="border-b border-neutral-200 bg-white">
  <nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-5">
    <a href="/" class="flex items-center gap-3">
      <img src="/logo-face.jpeg" alt="Lopez Solutions" class="h-8 w-8 rounded" />
      <span class="font-semibold text-petrol-dark">Lopez Solutions</span>
    </a>
    <ul class="flex gap-6 text-sm">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="text-ink hover:text-petrol transition-colors"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
