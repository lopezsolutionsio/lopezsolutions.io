---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const dateFmt = new Intl.DateTimeFormat("es-ES", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout title="Vlog — Lopez Solutions">
  <section class="mx-auto max-w-3xl px-6 py-20">
    <h1 class="text-4xl font-bold tracking-tight text-petrol-dark">Vlog</h1>
    <p class="mt-3 text-muted">Lo que estoy construyendo y aprendiendo.</p>

    {posts.length === 0 ? (
      <p class="mt-10 text-muted">Aún no hay posts publicados.</p>
    ) : (
      <ul class="mt-10 space-y-8">
        {posts.map((post) => (
          <li class="border-b border-neutral-200 pb-6 last:border-0">
            <a href={`/posts/${post.id}`} class="group block">
              <time class="text-xs uppercase tracking-wide text-muted">
                {dateFmt.format(post.data.publishedAt)}
              </time>
              <h2 class="mt-2 text-xl font-semibold text-ink group-hover:text-petrol transition-colors">
                {post.data.title}
              </h2>
              <p class="mt-2 text-muted">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Layout>
