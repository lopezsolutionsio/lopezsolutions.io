---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About — Lopez Solutions">
  <section class="mx-auto max-w-3xl px-6 py-20">
    <h1 class="text-4xl font-bold tracking-tight text-petrol-dark">About</h1>
    <div class="mt-8 space-y-5 text-lg leading-relaxed text-ink">
      <p>
        Hi, I'm David. I build software and share what I learn along the way.
      </p>
      <p>
        This site is both my vlog and my portfolio: in
        <a href="/posts" class="text-petrol underline">posts</a>
        I write and record about projects I'm working on; in
        <a href="/projects" class="text-petrol underline">projects</a>
        you can see what I've built.
      </p>
      <p>
        Want to get in touch? Email me at
        <a href="mailto:david.vazquez.us@gmail.com" class="text-petrol underline">
          david.vazquez.us@gmail.com
        </a>.
      </p>
    </div>
  </section>
</Layout>
