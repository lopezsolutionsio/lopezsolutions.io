---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout title="Portafolio — Lopez Solutions">
  <section class="mx-auto max-w-5xl px-6 py-20">
    <h1 class="text-4xl font-bold tracking-tight text-petrol-dark">Portafolio</h1>
    <p class="mt-3 text-muted">Proyectos que he construido.</p>

    {projects.length === 0 ? (
      <p class="mt-10 text-muted">Aún no hay proyectos listados.</p>
    ) : (
      <ul class="mt-10 grid gap-6 sm:grid-cols-2">
        {projects.map((project) => (
          <li class="rounded-lg border border-neutral-200 p-6 hover:border-petrol transition-colors">
            <a href={`/projects/${project.id}`} class="block">
              <h2 class="text-xl font-semibold text-ink">{project.data.title}</h2>
              <p class="mt-2 text-muted">{project.data.description}</p>
              {project.data.stack.length > 0 && (
                <ul class="mt-4 flex flex-wrap gap-2">
                  {project.data.stack.map((tech) => (
                    <li class="rounded-full bg-neutral-100 px-3 py-1 text-xs text-muted">
                      {tech}
                    </li>
                  ))}
                </ul>
              )}
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Layout>
