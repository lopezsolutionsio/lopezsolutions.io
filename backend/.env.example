# -----------------------------------------------------------------------------
# Strapi environment variables — template
#
# Copy this file to `.env` and fill in real values.
# For local development, sqlite defaults are fine.
# For production (AWS Lightsail), switch DATABASE_CLIENT to `postgres` and fill
# in the postgres connection block.
# -----------------------------------------------------------------------------

# Server
HOST=0.0.0.0
PORT=1337

# Secrets — regenerate for production!
# Generate each with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=change-me
ADMIN_JWT_SECRET=change-me
JWT_SECRET=change-me
TRANSFER_TOKEN_SALT=change-me
ENCRYPTION_KEY=change-me

# ---------------- Database ----------------
# Local development: sqlite (default, zero setup)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# ---------------- Production (PostgreSQL on Lightsail) ----------------
# Uncomment and fill these on the server, comment out sqlite lines above.
#
# DATABASE_CLIENT=postgres
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432
# DATABASE_NAME=lopezsolutions
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=change-me
# DATABASE_SSL=false
